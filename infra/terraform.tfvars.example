# cp terraform.tfvars.example terraform.tfvars && terraform init && terraform apply
subscription_id = "00000000-0000-0000-0000-000000000000"
tenant_id       = "00000000-0000-0000-0000-000000000000"

name_prefix    = "agentctl"
environment    = "dev"
location       = "eastus2"
location_short = "eus2"
tags           = { owner = "platform-team" }

# AzureCloud | AzureUSGovernment | AzureChinaCloud (providers + app endpoints). See docs/ENVIRONMENTS.md.
cloud = "AzureCloud"

# Extra subscriptions to discover Foundry in (Resource Graph), or every subscription the user can read.
observed_subscription_ids = []
observe_all_subscriptions = false

resource_group = { create = true }

# Bring your own workspace / App Insights by flipping create = false and setting existing_id.
log_analytics = { create = true, retention_days = 90 }
app_insights  = { create = true }
# log_analytics = { create = false, existing_id = "/subscriptions/.../resourceGroups/rg-monitor/providers/Microsoft.OperationalInsights/workspaces/law-central" }
# More workspaces (any subscription), queried together with the primary; e.g. per-team App Insights.
additional_log_analytics_ids = []

# Observe existing Foundry accounts (projects are discovered at runtime) ...
foundry = {
  create = false
  existing_account_ids = [
    # "/subscriptions/.../resourceGroups/rg-ai-prod/providers/Microsoft.CognitiveServices/accounts/aif-contoso-prod",
  ]
}
# ... or create a sandbox account + project wired to App Insights:
# foundry = {
#   create       = true
#   project_name = "agents"
#   model_deployments = {
#     "gpt-4.1-mini" = { model_name = "gpt-4.1-mini", model_version = "2025-04-14", capacity = 50 }
#   }
# }

# App roles: reader, identity_reader, requester, builder, approver, admin. See docs/ACCESS.md.
# Either let Terraform create one group per role ...
role_groups = {
  create = true # agentctl-<env>-admins, -readers, -requesters, -builders, -approvers, -identity-readers
  members = {
    admin = [] # ["<user-or-group-object-id>"]
    # reader    = []
    # requester = []
  }
}
# ... and/or assign existing users/groups directly.
app_role_assignments = {
  # builder = ["<group-object-id>"]
}

# Unscoped viewers (admins, identity analysts): Reader + Log Analytics Reader + Foundry User on the
# accounts. Don't add scoped users here.
viewer_principal_ids = []

# Data scopes: members see only these projects (Azure-enforced) and agents (UI filter), and can
# query only the App* trace tables. See docs/ACCESS.md.
access_scopes = {
  # hr-team = {
  #   create_group = true
  #   members      = ["<user-object-id>"]
  #   projects     = [{ account_id = "/subscriptions/.../accounts/aif-contoso-prod", project = "agents" }]
  #   agents       = ["hr-*"]
  #   telemetry    = true
  # }
}
unscoped_default = "all" # "none" = users in no scope see nothing (Admins are never scoped)

# Exports sign-in + Graph activity logs to the workspace (P1/P2 + Security Admin required).
# Leave false if the tenant already exports them to this workspace.
entra_diagnostics   = { enabled = false }
grant_admin_consent = false

gitops = {
  repo      = "https://github.com/contoso/agent-gitops"
  base_path = "agents"
  # Relative to agents/<name>/terraform in the agents-gitops repo, or a pinned git source.
  agent_module_source = "../../../modules/foundry-agent"
}

approver_groups = {
  read       = ["agent-owners"]
  write      = ["agent-owners", "platform-security"]
  privileged = ["agent-owners", "platform-security", "identity-admins"]
}

bundle_storage = { enabled = false }

# Hosting. Disable to run the app only locally (e.g. no App Service quota yet).
app_service = { enabled = true, sku_name = "B1" }

# AI risk controls (docs/CONTROLS.md): environment-wide sign-offs and the MCP server registry.
approved_mcp_hosts = [] # ["mcp.contoso.com"]
control_attestations = {
  # "GV-05" = { status = "attested", evidence = "https://lms.contoso.example/ai-literacy", owner = "platform-security", date = "2026-09-01", expires = "2027-09-01" }
  # "IR-02" = { status = "attested", evidence = "https://wiki.contoso.example/ai-incident-runbook", owner = "soc", date = "2026-06-15", expires = "2027-06-15" }
}

# Private networking (docs/ENVIRONMENTS.md §4). Bring your own VNet, subnets and hub DNS zones.
network = {
  enabled = false
  # app_subnet_id              = "/subscriptions/.../subnets/snet-agentctl-app" # delegated to Microsoft.Web/serverFarms
  # private_endpoint_subnet_id = "/subscriptions/.../subnets/snet-pe"
  # app_private_endpoint       = true
  # foundry_private_endpoint   = true
  # monitor_private_link       = { enabled = true, query_access_mode = "PrivateOnly" }
  # private_dns_zone_ids       = { "privatelink.azurewebsites.net" = "/subscriptions/.../privateDnsZones/privatelink.azurewebsites.net" }
}
