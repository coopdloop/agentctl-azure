{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentctl.lariat.dev/schemas/v1alpha1/agent.schema.json",
  "title": "agentctl Agent manifest",
  "description": "Declarative definition of a Foundry agent, its tools, identity, guardrails and platform harness injections. Consumed by the GitOps pipeline.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "agentctl.lariat.dev/v1alpha1" },
    "kind": { "const": "Agent" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "displayName", "description", "owners", "team", "dataClassification", "environment"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,62}$", "description": "DNS-style slug; becomes the Foundry agent name and folder name in the GitOps repo." },
        "displayName": { "type": "string", "minLength": 3, "maxLength": 128 },
        "description": { "type": "string", "minLength": 10, "maxLength": 2000 },
        "owners": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 }, "description": "UPNs or group names accountable for the agent." },
        "team": { "type": "string", "minLength": 2 },
        "costCenter": { "type": "string" },
        "dataClassification": { "enum": ["public", "internal", "confidential", "highly_confidential"] },
        "environment": { "enum": ["dev", "test", "prod"] },
        "labels": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["foundry", "model", "instructions", "harness", "tools", "knowledge", "identity", "access", "guardrails", "observability", "lifecycle"],
      "properties": {
        "foundry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["subscriptionId", "resourceGroup", "account", "project"],
          "properties": {
            "subscriptionId": { "type": "string", "pattern": "^[0-9a-fA-F-]{36}$|^\\$\\{.+\\}$" },
            "resourceGroup": { "type": "string", "minLength": 1 },
            "account": { "type": "string", "minLength": 2 },
            "project": { "type": "string", "minLength": 2 }
          }
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["deployment", "modelName"],
          "properties": {
            "deployment": { "type": "string", "minLength": 1 },
            "modelName": { "type": "string", "minLength": 1 },
            "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
            "topP": { "type": "number", "minimum": 0, "maximum": 1 },
            "responseFormat": { "enum": ["auto", "text", "json_object"] }
          }
        },
        "instructions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["system", "version"],
          "properties": {
            "system": { "type": "string", "minLength": 20, "maxLength": 256000 },
            "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" }
          }
        },
        "harness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["injections"],
          "description": "Platform-owned instruction fragments composed around the owner's system prompt.",
          "properties": {
            "injections": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "position", "text", "reason", "mandatory"],
                "properties": {
                  "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-.]*$" },
                  "position": { "enum": ["prepend", "append"] },
                  "text": { "type": "string", "minLength": 10 },
                  "reason": { "type": "string", "minLength": 5 },
                  "mandatory": { "type": "boolean" }
                }
              }
            }
          }
        },
        "tools": { "type": "array", "items": { "$ref": "#/$defs/tool" } },
        "knowledge": {
          "type": "object",
          "additionalProperties": false,
          "required": ["vectorStores", "searchIndexes"],
          "properties": {
            "vectorStores": {
              "type": "array",
              "items": { "type": "object", "additionalProperties": false, "required": ["name", "source"], "properties": { "name": { "type": "string" }, "source": { "type": "string" } } }
            },
            "searchIndexes": {
              "type": "array",
              "items": { "type": "object", "additionalProperties": false, "required": ["connectionName", "indexName"], "properties": { "connectionName": { "type": "string" }, "indexName": { "type": "string" } } }
            }
          }
        },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "allowedAuthFlows", "delegatedScopes", "appRoles", "azureRoleAssignments"],
          "properties": {
            "type": { "enum": ["agent_identity", "user_assigned_mi", "project_mi"] },
            "allowedAuthFlows": { "type": "array", "uniqueItems": true, "items": { "enum": ["delegated", "obo", "app"] } },
            "delegatedScopes": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
            "appRoles": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
            "azureRoleAssignments": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["scope", "role", "justification"],
                "properties": { "scope": { "type": "string", "pattern": "^/subscriptions/" }, "role": { "type": "string" }, "justification": { "type": "string", "minLength": 5 } }
              }
            }
          },
          "allOf": [
            { "if": { "properties": { "delegatedScopes": { "minItems": 1 } } }, "then": { "properties": { "allowedAuthFlows": { "contains": { "enum": ["delegated", "obo"] } } } } },
            { "if": { "properties": { "appRoles": { "minItems": 1 } } }, "then": { "properties": { "allowedAuthFlows": { "contains": { "const": "app" } } } } }
          ]
        },
        "access": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allowedGroups", "allowedClientApps", "exposure"],
          "properties": {
            "allowedGroups": { "type": "array", "items": { "type": "string" } },
            "allowedClientApps": { "type": "array", "items": { "type": "string" } },
            "exposure": { "enum": ["internal", "teams", "m365_copilot", "api"] }
          }
        },
        "guardrails": {
          "type": "object",
          "additionalProperties": false,
          "required": ["raiPolicy", "limits", "piiRedactionInTraces"],
          "properties": {
            "raiPolicy": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "basePolicy", "mode", "filters", "promptShields", "protectedMaterial"],
              "properties": {
                "name": { "type": "string", "pattern": "^(?!Microsoft\\.)[A-Za-z0-9_.-]{2,64}$", "description": "Custom policy name; built-in Microsoft.* policies cannot be managed." },
                "basePolicy": { "type": "string" },
                "mode": { "enum": ["Blocking", "Asynchronous_filter", "Deferred"] },
                "filters": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["hate", "sexual", "violence", "selfharm"],
                  "properties": {
                    "hate": { "$ref": "#/$defs/contentFilter" },
                    "sexual": { "$ref": "#/$defs/contentFilter" },
                    "violence": { "$ref": "#/$defs/contentFilter" },
                    "selfharm": { "$ref": "#/$defs/contentFilter" }
                  }
                },
                "promptShields": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["jailbreak", "indirectAttack"],
                  "properties": { "jailbreak": { "type": "boolean" }, "indirectAttack": { "type": "boolean" } }
                },
                "protectedMaterial": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["text", "code"],
                  "properties": { "text": { "type": "boolean" }, "code": { "type": "boolean" } }
                }
              }
            },
            "limits": {
              "type": "object",
              "additionalProperties": false,
              "required": ["maxTokensPerRun", "maxToolCallsPerRun", "maxRunSeconds"],
              "properties": {
                "maxTokensPerRun": { "type": "integer", "minimum": 256, "maximum": 2000000 },
                "maxToolCallsPerRun": { "type": "integer", "minimum": 0, "maximum": 500 },
                "maxRunSeconds": { "type": "integer", "minimum": 5, "maximum": 3600 }
              }
            },
            "piiRedactionInTraces": { "type": "boolean" }
          }
        },
        "observability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tracing", "captureContent", "sampleRate"],
          "properties": {
            "tracing": { "type": "boolean" },
            "captureContent": { "type": "boolean" },
            "sampleRate": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "lifecycle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reviewCadenceDays"],
          "properties": {
            "reviewCadenceDays": { "type": "integer", "minimum": 7, "maximum": 365 },
            "expiresOn": { "type": "string", "format": "date" }
          }
        }
      }
    }
  },
  "$defs": {
    "contentFilter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "blocking", "severityThreshold"],
      "properties": {
        "enabled": { "type": "boolean" },
        "blocking": { "type": "boolean" },
        "severityThreshold": { "enum": ["Low", "Medium", "High"] }
      }
    },
    "injectedBy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["by", "reason"],
      "properties": { "by": { "type": "string" }, "reason": { "type": "string", "minLength": 5 }, "changeRequest": { "type": "string" } }
    },
    "tool": {
      "type": "object",
      "required": ["name", "type", "riskTier", "requireApproval"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,64}$" },
        "type": {
          "enum": ["code_interpreter", "file_search", "bing_grounding", "azure_ai_search", "sharepoint_grounding", "fabric_dataagent", "browser_automation", "openapi", "mcp", "azure_function", "connected_agent"]
        },
        "description": { "type": "string" },
        "riskTier": { "enum": ["read", "write", "privileged"] },
        "requireApproval": { "enum": ["always", "never", "write_only"] },
        "injected": { "$ref": "#/$defs/injectedBy" },
        "openapi": {
          "type": "object",
          "additionalProperties": false,
          "required": ["operations", "auth"],
          "properties": {
            "specUrl": { "type": "string", "format": "uri" },
            "specInline": { "type": "string" },
            "operations": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["operationId", "method", "path"],
                "properties": { "operationId": { "type": "string" }, "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] }, "path": { "type": "string" } }
              }
            },
            "auth": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type"],
              "properties": { "type": { "enum": ["anonymous", "managed_identity", "connection"] }, "audience": { "type": "string" }, "connectionName": { "type": "string" } }
            }
          }
        },
        "mcp": {
          "type": "object",
          "additionalProperties": false,
          "required": ["serverLabel", "serverUrl", "allowedTools"],
          "properties": {
            "serverLabel": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$" },
            "serverUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
            "allowedTools": { "type": "array", "items": { "type": "string" } },
            "headersFromConnection": { "type": "string" }
          }
        },
        "azureFunction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["functionAppResourceId", "functionName", "inputQueue", "outputQueue"],
          "properties": {
            "functionAppResourceId": { "type": "string", "pattern": "^/subscriptions/" },
            "functionName": { "type": "string" },
            "inputQueue": { "type": "string" },
            "outputQueue": { "type": "string" },
            "parametersSchema": { "type": "string" }
          }
        },
        "connectedAgent": {
          "type": "object",
          "additionalProperties": false,
          "required": ["agentRef", "delegationDescription"],
          "properties": { "agentRef": { "type": "string" }, "delegationDescription": { "type": "string", "minLength": 10 } }
        },
        "connection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["connectionName"],
          "properties": { "connectionName": { "type": "string" }, "indexName": { "type": "string" }, "queryType": { "type": "string" }, "topK": { "type": "integer", "minimum": 1, "maximum": 50 } }
        },
        "builtin": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "vectorStoreIds": { "type": "array", "items": { "type": "string" } }, "allowedDomains": { "type": "array", "items": { "type": "string" } } }
        }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "openapi" } } }, "then": { "required": ["openapi"] } },
        { "if": { "properties": { "type": { "const": "mcp" } } }, "then": { "required": ["mcp"] } },
        { "if": { "properties": { "type": { "const": "azure_function" } } }, "then": { "required": ["azureFunction"] } },
        { "if": { "properties": { "type": { "const": "connected_agent" } } }, "then": { "required": ["connectedAgent"] } },
        { "if": { "properties": { "type": { "enum": ["bing_grounding", "azure_ai_search", "sharepoint_grounding", "fabric_dataagent"] } } }, "then": { "required": ["connection"] } },
        { "if": { "properties": { "riskTier": { "const": "privileged" } } }, "then": { "properties": { "requireApproval": { "const": "always" } } } },
        { "if": { "properties": { "type": { "const": "browser_automation" } } }, "then": { "properties": { "riskTier": { "const": "privileged" } } } }
      ]
    }
  }
}
