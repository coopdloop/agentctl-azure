# Copy to .env.local (or generate it: scripts/local-env-from-tf.sh). Restart `npm run dev` after edits.
# Leave the ids blank to run in mock mode with seeded data. Reference: docs/ENVIRONMENTS.md
AGENTCTL_MODE=mock
AGENTCTL_ENVIRONMENT=local
AGENTCTL_TENANT_ID=
AGENTCTL_CLIENT_ID=
AGENTCTL_REDIRECT_URI=http://localhost:5173/

# Cloud: AzureCloud | AzureUSGovernment | AzureChinaCloud. Override single endpoints with
# AGENTCTL_ENDPOINT_{AUTHORITY,ARM,GRAPH,LOG_ANALYTICS,LOG_ANALYTICS_AUDIENCE,FOUNDRY_AUDIENCE,FOUNDRY_HOST_SUFFIXES}
AGENTCTL_CLOUD=AzureCloud

# Primary subscription (defaults for new agents) and extra subscriptions to observe (comma-separated).
# Both empty = every subscription the signed-in user can read (Azure Resource Graph).
AGENTCTL_SUBSCRIPTION_ID=
AGENTCTL_SUBSCRIPTION_IDS=
# Comma-separated; empty = all resource groups
AGENTCTL_RESOURCE_GROUPS=

# Log Analytics workspace customer id (GUID): "Workspace ID" on the portal blade
AGENTCTL_LAW_WORKSPACE_ID=
AGENTCTL_LAW_RESOURCE_ID=
# More workspace customer ids queried together with the primary (other subscriptions/regions/teams)
AGENTCTL_LAW_ADDITIONAL_WORKSPACE_IDS=
AGENTCTL_APPINSIGHTS_RESOURCE_ID=

# Optional: comma-separated Foundry project endpoints. Empty = discover via Resource Graph.
# Set it when users are scoped to projects and discovery can't see them.
AGENTCTL_FOUNDRY_PROJECT_ENDPOINTS=
AGENTCTL_FOUNDRY_API_VERSION=v1

# Private networking: APIs the browser reaches through the app's /proxy (arm, graph, logAnalytics).
# Foundry always goes through /proxy.
AGENTCTL_PROXY_SERVICES=

# Data scopes (JSON); usually generated by Terraform. See docs/ACCESS.md.
AGENTCTL_ACCESS_SCOPES=

# AI risk controls (docs/CONTROLS.md): environment sign-offs (JSON, keyed "GV-05" or "TL-04@agent")
# and MCP server hosts approved for TL-02 (comma-separated). Usually generated by Terraform.
AGENTCTL_ATTESTATIONS=
AGENTCTL_APPROVED_MCP_HOSTS=

AGENTCTL_GITOPS_REPO=
AGENTCTL_GITOPS_BASE_PATH=agents
AGENTCTL_AGENT_MODULE_SOURCE=../../../modules/foundry-agent
AGENTCTL_APPROVERS_READ=agent-owners
AGENTCTL_APPROVERS_WRITE=agent-owners,platform-security
AGENTCTL_APPROVERS_PRIVILEGED=agent-owners,platform-security,identity-admins
