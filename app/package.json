{
  "name": "agentctl",
  "private": true,
  "version": "0.1.0",
  "description": "Agentic platform control plane: agent activity, identity, guardrails and GitOps bundle builder for Azure AI Foundry.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "gen": "node scripts/gen-validators.mjs",
    "predev": "npm run gen",
    "dev": "vite",
    "prebuild": "npm run gen",
    "build": "tsc -b && vite build",
    "typecheck": "npm run gen && tsc -b --noEmit",
    "pretest": "npm run gen",
    "test": "vitest run",
    "start": "node server/server.mjs",
    "package": "npm run build && node scripts/package-app.mjs"
  },
  "devDependencies": {
    "@azure/msal-browser": "^4.4.0",
    "@azure/msal-react": "^3.0.4",
    "@fluentui/react-components": "^9.56.0",
    "@fluentui/react-icons": "^2.0.266",
    "@tanstack/react-query": "^5.59.16",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.0.1",
    "@types/diff": "^5.2.3",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "diff": "^5.2.0",
    "jsdom": "^25.0.1",
    "jszip": "^3.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.13.3",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5",
    "yaml": "^2.6.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
